<Window x:Class="SpeedLimit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpeedLimit"
        Title="FlowCap" Width="1180" Height="860" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" Foreground="{DynamicResource Ink}" Background="{DynamicResource WindowBg}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <!-- Farben/Formen des Themes: Standardwerte = "Graphit Neon", MainWindow.ApplyTheme ersetzt sie zur Laufzeit -->
        <LinearGradientBrush x:Key="WindowBg" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0B0F" Offset="0" />
            <GradientStop Color="#16161D" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="Ink" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Hairline" Color="#00000000" />
        <SolidColorBrush x:Key="Hover" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="SelectionBg" Color="#1A00E5FF" />
        <SolidColorBrush x:Key="SelectionBorder" Color="#8000E5FF" />
        <SolidColorBrush x:Key="AccentSoft" Color="#2600E5FF" />
        <SolidColorBrush x:Key="UpSoft" Color="#33A3FF12" />
        <SolidColorBrush x:Key="OnAccent" Color="#0B0B0F" />
        <SolidColorBrush x:Key="DangerSoft" Color="#40FF4D6D" />
        <SolidColorBrush x:Key="Scrim" Color="#B3000000" />
        <SolidColorBrush x:Key="Dialog" Color="#1B1B23" />
        <SolidColorBrush x:Key="DialogBorder" Color="#24FFFFFF" />
        <CornerRadius x:Key="CardRadius">12</CornerRadius>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="DownBrush" Color="#00E5FF" />
        <SolidColorBrush x:Key="UpBrush" Color="#A3FF12" />
        <SolidColorBrush x:Key="Panel" Color="#0FFFFFFF" />
        <SolidColorBrush x:Key="PanelInner" Color="#0CFFFFFF" />
        <SolidColorBrush x:Key="Muted" Color="#8CFFFFFF" />
        <SolidColorBrush x:Key="Accent" Color="#00E5FF" />
        <SolidColorBrush x:Key="Danger" Color="#FF4D6D" />
        <!-- Fluent-Akzent (Auswahl, Schieberegler, Häkchen, Umschalter) auf Neon-Cyan umstellen -->
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#00E5FF" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E600E5FF" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC00E5FF" />
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#0B0B0F" />

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,22,0,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}" />
            <Setter Property="Background" Value="{DynamicResource Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="Pill" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="Preset" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Listenzeile mit eigener, weicher Auswahl statt Windows-Blau -->
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="8" Padding="10,0" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectionBg}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource SelectionBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="ScrollingItems" TargetType="ItemsControl">
            <ScrollViewer Focusable="False" Padding="0,0,6,0">
                <ItemsPresenter />
            </ScrollViewer>
        </ControlTemplate>

        <!-- Download-/Upload-Limit mit Schieberegler; DataContext = AppRow (Programm oder Gesamtlimit) -->
        <DataTemplate x:Key="LimitEditor">
            <StackPanel>
                <Border Padding="14" CornerRadius="10" Background="{DynamicResource PanelInner}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="Begrenzen" IsChecked="{Binding DownLimited}" MinWidth="0" Foreground="{DynamicResource Ink}" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                <Run FontFamily="{StaticResource Icons}" Text="&#xE74B;" Foreground="{DynamicResource DownBrush}" /> Download
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{Binding LimitDownText}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <Slider Minimum="0" Maximum="1000" Value="{Binding DownSlider}" IsEnabled="{Binding DownLimited}"
                                SmallChange="10" LargeChange="50" AutomationProperties.Name="Download-Limit" />
                        <WrapPanel Margin="0,8,0,-6">
                            <Button Style="{StaticResource Preset}" Content="500 KB/s" Tag="d:500" Click="Preset_Click" />
                            <Button Style="{StaticResource Preset}" Content="1 MB/s" Tag="d:1024" Click="Preset_Click" />
                            <Button Style="{StaticResource Preset}" Content="5 MB/s" Tag="d:5120" Click="Preset_Click" />
                            <Button Style="{StaticResource Preset}" Content="10 MB/s" Tag="d:10240" Click="Preset_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Margin="0,12,0,0" Padding="14" CornerRadius="10" Background="{DynamicResource PanelInner}">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="Begrenzen" IsChecked="{Binding UpLimited}" MinWidth="0" Foreground="{DynamicResource Ink}" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                <Run FontFamily="{StaticResource Icons}" Text="&#xE74A;" Foreground="{DynamicResource UpBrush}" /> Upload
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{Binding LimitUpText}" FontSize="24" FontWeight="SemiBold" Margin="0,8,0,4" />
                        <Slider Minimum="0" Maximum="1000" Value="{Binding UpSlider}" IsEnabled="{Binding UpLimited}"
                                SmallChange="10" LargeChange="50" AutomationProperties.Name="Upload-Limit" />
                        <WrapPanel Margin="0,8,0,-6">
                            <Button Style="{StaticResource Preset}" Content="500 KB/s" Tag="u:500" Click="Preset_Click" />
                            <Button Style="{StaticResource Preset}" Content="1 MB/s" Tag="u:1024" Click="Preset_Click" />
                            <Button Style="{StaticResource Preset}" Content="5 MB/s" Tag="u:5120" Click="Preset_Click" />
                            <Button Style="{StaticResource Preset}" Content="10 MB/s" Tag="u:10240" Click="Preset_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid Margin="22,12,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Kopfzeile: Titel, Reiter, Pause, Einstellungen -->
            <DockPanel Grid.Row="0" Margin="2,0,2,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ScheduleBadge" CornerRadius="13" Padding="10,4" Margin="0,0,8,0" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center"
                            Visibility="Collapsed" ToolTip="Das Profil wurde von einem Zeitplan gewählt">
                        <TextBlock FontSize="12"><Run FontFamily="{StaticResource Icons}" Text="&#xE823;" Foreground="{DynamicResource Accent}" /> Zeitplan</TextBlock>
                    </Border>
                    <TextBlock Text="Profil" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ProfileBox" MinWidth="150" Height="34" VerticalAlignment="Center" SelectionChanged="ProfileBox_SelectionChanged"
                              AutomationProperties.Name="Profil" ToolTip="Profil wechseln – neue Profile in den Einstellungen anlegen" />
                    <ToggleButton x:Name="PauseToggle" Style="{StaticResource IconToggle}" Click="Pause_Click"
                                  ToolTip="Alle Limits und Sperren vorübergehend aussetzen" AutomationProperties.Name="Limits pausieren">
                        <TextBlock><Run FontFamily="{StaticResource Icons}" Text="&#xE769;" /> <Run x:Name="PauseText" Text="Pausieren" /></TextBlock>
                    </ToggleButton>
                    <Button Style="{StaticResource IconButton}" Click="OpenSettings_Click" ToolTip="Einstellungen" AutomationProperties.Name="Einstellungen">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE713;" FontSize="16" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/flowcap.ico" Width="28" Height="28" Margin="0,0,10,0" />
                    <TextBlock Text="FlowCap" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Margin="32,0,0,0" VerticalAlignment="Center">
                        <RadioButton x:Name="LiveTab" Content="Live" IsChecked="True" GroupName="Tab" Style="{StaticResource Pill}" Checked="Tab_Changed" />
                        <RadioButton x:Name="UsageTab" Content="Verbrauch" GroupName="Tab" Style="{StaticResource Pill}" Checked="Tab_Changed" MinWidth="90" />
                        <RadioButton x:Name="SpeedTab" Content="Speedtest" GroupName="Tab" Style="{StaticResource Pill}" Checked="Tab_Changed" MinWidth="90" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- ===== Live ===== -->
            <Grid x:Name="LiveView" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="360" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="22,16,22,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <Border DockPanel.Dock="Right" CornerRadius="13" Padding="12,4" Background="{DynamicResource PanelInner}">
                                <TextBlock FontSize="12">
                                    <Run FontFamily="{StaticResource Icons}" Text="&#xE72E;" /> <Run x:Name="LimitedCount" FontWeight="SemiBold" /> eingeschränkt
                                </TextBlock>
                            </Border>
                            <Border DockPanel.Dock="Right" CornerRadius="13" Padding="12,4" Margin="0,0,8,0" Background="{DynamicResource PanelInner}"
                                    ToolTip="Ping zu Cloudflare (1.1.1.1), alle 5 Sekunden">
                                <TextBlock FontSize="12">
                                    <Run FontFamily="{StaticResource Icons}" Text="&#xEC05;" Foreground="{DynamicResource Accent}" /> Ping <Run x:Name="PingText" FontWeight="SemiBold" Text="…" />
                                </TextBlock>
                            </Border>
                            <Border x:Name="GameModePill" DockPanel.Dock="Right" CornerRadius="13" Padding="12,4" Margin="0,0,8,0"
                                    Background="{DynamicResource UpSoft}" Visibility="Collapsed">
                                <TextBlock FontSize="12">
                                    <Run FontFamily="{StaticResource Icons}" Text="&#xE7FC;" Foreground="{DynamicResource UpBrush}" /> <Run x:Name="GameModeText" FontWeight="SemiBold" />
                                </TextBlock>
                            </Border>
                            <TextBlock x:Name="GraphTitle" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </DockPanel>

                        <local:RateGraph x:Name="MainGraph" Grid.Row="1" ShowGrid="True" />

                        <Grid Grid.Row="2" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock HorizontalAlignment="Right">
                                    <Run x:Name="CurrentDown" FontSize="22" FontWeight="SemiBold" />
                                    <Run FontFamily="{StaticResource Icons}" Text="&#xE74B;" FontSize="16" Foreground="{DynamicResource DownBrush}" />
                                </TextBlock>
                                <TextBlock Text="Download" Style="{StaticResource Caption}" HorizontalAlignment="Right" Margin="0,0,22,0" />
                            </StackPanel>
                            <local:Gauge x:Name="TotalGauge" Grid.Column="2" Width="150" Height="92" />
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="20,0,0,0">
                                <TextBlock>
                                    <Run FontFamily="{StaticResource Icons}" Text="&#xE74A;" FontSize="16" Foreground="{DynamicResource UpBrush}" />
                                    <Run x:Name="CurrentUp" FontSize="22" FontWeight="SemiBold" />
                                </TextBlock>
                                <TextBlock Text="Upload" Style="{StaticResource Caption}" Margin="22,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="370" />
                    </Grid.ColumnDefinitions>

                    <!-- Programmliste -->
                    <Border Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="SearchBox" Padding="34,0,10,0" VerticalContentAlignment="Center" Height="34"
                                             TextChanged="Search_Changed" AutomationProperties.Name="Programm suchen" />
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE721;" Margin="11,0,0,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False" Foreground="{DynamicResource Muted}" />
                                    <TextBlock Text="Programm suchen…" Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{DynamicResource Muted}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <RadioButton x:Name="ActiveOnly" Content="Aktiv" IsChecked="True" GroupName="Filter" Style="{StaticResource Pill}"
                                                 Checked="Filter_Changed" ToolTip="Nur Programme mit Netzwerkverkehr oder Einschränkung" />
                                    <RadioButton Content="Alle" GroupName="Filter" Style="{StaticResource Pill}" Checked="Filter_Changed"
                                                 ToolTip="Alle laufenden Programme" />
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="1" Margin="11,0,22,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="PROGRAMM" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="2" Text="DOWNLOAD" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="3" Text="UPLOAD" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="4" Text="VERLAUF" Style="{StaticResource Caption}" />
                            </Grid>

                            <ListBox x:Name="AppList" Grid.Row="2" BorderThickness="0" Background="Transparent"
                                     ItemContainerStyle="{StaticResource Row}"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="AppList_SelectionChanged" AutomationProperties.Name="Programme">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="44">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="260" />
                                                <Border CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource Accent}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource Danger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnAccent}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DownText}" Foreground="{DynamicResource DownBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding UpText}" Foreground="{DynamicResource UpBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <local:RateGraph Grid.Column="4" Height="28" VerticalAlignment="Center" Down="{Binding DownRecent}" Up="{Binding UpRecent}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Detailbereich für das ausgewählte Programm -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" DataContext="{Binding SelectedItem, ElementName=AppList}">
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE7C4;" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" />
                                <TextBlock Text="Programm links auswählen," HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="{DynamicResource Muted}" />
                                <TextBlock Text="um es zu drosseln oder zu sperren." HorizontalAlignment="Center" Foreground="{DynamicResource Muted}" />
                            </StackPanel>

                            <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                                <StackPanel>
                                    <DockPanel>
                                        <Image Source="{Binding Icon}" Width="40" Height="40" Margin="0,0,14,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="↓" Foreground="{DynamicResource DownBrush}" /> <Run Text="{Binding DownText, Mode=OneWay}" />
                                                <Run Text="   ↑" Foreground="{DynamicResource UpBrush}" /> <Run Text="{Binding UpText, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="Heute:" /> <Run Text="{Binding UsageToday, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Internet sperren -->
                                    <Border Margin="0,18,0,12" Padding="14,10" CornerRadius="10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource PanelInner}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource DangerSoft}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsBlocked}" MinWidth="0" VerticalAlignment="Center"
                                                      Margin="12,0,0,0" AutomationProperties.Name="Internet sperren" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run FontFamily="{StaticResource Icons}" Text="&#xE72E;" Foreground="{DynamicResource Danger}" /> Internet sperren
                                                </TextBlock>
                                                <TextBlock Text="Blockiert allen Datenverkehr dieses Programms" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LimitEditor}" IsEnabled="{Binding IsNotBlocked}" Focusable="False" />

                                    <Button Content="Alle Einschränkungen entfernen" HorizontalAlignment="Stretch" Margin="0,14,0,0" Height="36"
                                            IsEnabled="{Binding IsLimited}" Click="ClearLimit_Click" />

                                    <!-- Datenlimit -->
                                    <Border Margin="0,14,0,0" Padding="14" CornerRadius="10" Background="{DynamicResource PanelInner}">
                                        <StackPanel>
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" Content="Aktiv" IsChecked="{Binding CapEnabled}" MinWidth="0" Foreground="{DynamicResource Ink}"
                                                          AutomationProperties.Name="Datenlimit aktiv" />
                                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                                    <Run FontFamily="{StaticResource Icons}" Text="&#xE9D2;" Foreground="{DynamicResource Accent}" /> Datenlimit
                                                </TextBlock>
                                            </DockPanel>
                                            <StackPanel IsEnabled="{Binding CapEnabled}" Margin="0,10,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{x:Static local:AppRow.CapPresetNames}" SelectedIndex="{Binding CapPresetIndex}"
                                                              AutomationProperties.Name="Datenmenge" HorizontalAlignment="Stretch" />
                                                    <ComboBox Grid.Column="2" ItemsSource="{x:Static local:AppRow.CapPeriodNames}" SelectedIndex="{Binding CapPeriodIndex}"
                                                              AutomationProperties.Name="Zeitraum" HorizontalAlignment="Stretch" />
                                                </Grid>
                                                <CheckBox Content="Bei Erreichen sperren" IsChecked="{Binding CapBlock}" Margin="0,8,0,0" Foreground="{DynamicResource Ink}" />
                                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding CapShare, Mode=OneWay}" Height="6" Margin="0,10,0,4" />
                                                <TextBlock Text="{Binding CapStatus}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Spielmodus-Vorrang -->
                                    <Border Margin="0,12,0,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource PanelInner}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding IsPriority}" MinWidth="0" VerticalAlignment="Center" Margin="12,0,0,0"
                                                      AutomationProperties.Name="Vorrang im Spielmodus" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold">
                                                    <Run FontFamily="{StaticResource Icons}" Text="&#xE7FC;" Foreground="{DynamicResource UpBrush}" /> Vorrang im Spielmodus
                                                </TextBlock>
                                                <TextBlock Text="Solange es läuft, werden alle anderen Programme gedrosselt" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <!-- VPN -->
                                    <Border Margin="0,12,0,0" Padding="14" CornerRadius="10" Background="{DynamicResource PanelInner}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run FontFamily="{StaticResource Icons}" Text="&#xE705;" Foreground="{DynamicResource UpBrush}" /> VPN (WireGuard)
                                            </TextBlock>
                                            <ComboBox ItemsSource="{Binding VpnChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding VpnChoice}" HorizontalAlignment="Stretch" Margin="0,8,0,6"
                                                      AutomationProperties.Name="VPN für dieses Programm" />
                                            <TextBlock Text="{Binding VpnStatus}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            <TextBlock Text="Der gesamte Verkehr dieses Programms läuft durch den Tunnel (hat Vorrang vor einem Proxy). Ist der Tunnel getrennt, hat das Programm kein Internet – mit Kill-Switch wird es beendet. Configs lädst du in den Einstellungen."
                                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Proxy -->
                                    <Border Margin="0,12,0,0" Padding="14" CornerRadius="10" Background="{DynamicResource PanelInner}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold">
                                                <Run FontFamily="{StaticResource Icons}" Text="&#xE968;" Foreground="{DynamicResource Accent}" /> Proxy
                                            </TextBlock>
                                            <ComboBox ItemsSource="{Binding ProxyChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding ProxyChoice}" HorizontalAlignment="Stretch" Margin="0,8,0,6"
                                                      AutomationProperties.Name="Proxy für dieses Programm" />
                                            <TextBlock Text="TCP-Verbindungen laufen über den Proxy. UDP und IPv6 werden für dieses Programm gesperrt, damit nichts am Proxy vorbeigeht. Proxys richtest du in den Einstellungen ein."
                                                       Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Verbindungen -->
                                    <TextBlock x:Name="ConnHeader" Style="{StaticResource Section}" Text="VERBINDUNGEN" />
                                    <ItemsControl x:Name="ConnList" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="10,6" Margin="0,0,0,4" CornerRadius="8" Background="{DynamicResource PanelInner}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Host}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Host}" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="ConnEmpty" Text="Gerade keine offenen TCP-Verbindungen." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ===== Verbrauch ===== -->
            <!-- ===== Speedtest ===== -->
            <Grid x:Name="SpeedView" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="370" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="28,24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="520">
                        <TextBlock Text="Speedtest" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Misst Ping, Download und Upload deiner Internetleitung über die Server von Cloudflare. Limits gelten dabei nicht."
                                   Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" Margin="0,4,0,18" />
                        <local:Gauge x:Name="SpeedGauge" Width="320" Height="200" Maximum="100" Label="–" Caption="bereit" HorizontalAlignment="Center" />
                        <TextBlock x:Name="SpeedPhase" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,18" />

                        <UniformGrid Columns="4" Margin="0,0,0,22">
                            <UniformGrid.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="Margin" Value="5,0" />
                                    <Setter Property="Padding" Value="14,10" />
                                    <Setter Property="CornerRadius" Value="10" />
                                    <Setter Property="Background" Value="{DynamicResource PanelInner}" />
                                </Style>
                            </UniformGrid.Resources>
                            <Border>
                                <StackPanel>
                                    <TextBlock Text="PING" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="SpeedPing" Text="–" FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border>
                                <StackPanel>
                                    <TextBlock Text="JITTER" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="SpeedJitter" Text="–" FontSize="22" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}"><Run Text="↓" Foreground="{DynamicResource DownBrush}" /> DOWNLOAD</TextBlock>
                                    <TextBlock x:Name="SpeedDown" Text="–" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource DownBrush}" />
                                </StackPanel>
                            </Border>
                            <Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Caption}"><Run Text="↑" Foreground="{DynamicResource UpBrush}" /> UPLOAD</TextBlock>
                                    <TextBlock x:Name="SpeedUp" Text="–" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource UpBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Button x:Name="SpeedButton" Content="Test starten" Click="Speedtest_Click" HorizontalAlignment="Center"
                                MinWidth="180" Height="40" FontSize="15" Style="{DynamicResource AccentButtonStyle}" />
                        <TextBlock x:Name="SpeedError" Foreground="{DynamicResource Danger}" FontSize="12" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="LETZTE TESTS" Style="{StaticResource Section}" Margin="0,0,0,10" />
                        <TextBlock x:Name="SpeedHistoryEmpty" DockPanel.Dock="Top" Text="Noch keine Tests." Style="{StaticResource Caption}" />
                        <ItemsControl x:Name="SpeedHistory" Template="{StaticResource ScrollingItems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource PanelInner}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Time, StringFormat={}{0:dd.MM.yyyy  HH:mm}}" Style="{StaticResource Caption}" />
                                            <TextBlock Margin="0,2,0,0">
                                                <Run Text="↓" Foreground="{DynamicResource DownBrush}" /> <Run Text="{Binding DownMbps, Mode=OneWay, StringFormat={}{0:0.0} Mbit/s}" FontWeight="SemiBold" />
                                                <Run Text="   ↑" Foreground="{DynamicResource UpBrush}" /> <Run Text="{Binding UpMbps, Mode=OneWay, StringFormat={}{0:0.0} Mbit/s}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="Ping" /> <Run Text="{Binding PingMs, Mode=OneWay, StringFormat={}{0:0} ms}" />
                                                <Run Text="  ·  Jitter" /> <Run Text="{Binding JitterMs, Mode=OneWay, StringFormat={}{0:0} ms}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>

            <Border x:Name="UsageView" Grid.Row="1" Style="{StaticResource Card}" Padding="22,18" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,16">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton x:Name="PeriodToday" Content="Heute" IsChecked="True" GroupName="Period" Style="{StaticResource Pill}" Checked="Period_Changed" />
                            <RadioButton x:Name="PeriodWeek" Content="7 Tage" GroupName="Period" Style="{StaticResource Pill}" Checked="Period_Changed" />
                            <RadioButton Content="30 Tage" GroupName="Period" Style="{StaticResource Pill}" Checked="Period_Changed" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Datenverbrauch" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock x:Name="UsageSummary" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="10,0,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="PROGRAMM" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="2" Text="DOWNLOAD" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="3" Text="UPLOAD" Style="{StaticResource Caption}" />
                        <TextBlock Grid.Column="4" Text="GESAMT" Style="{StaticResource Caption}" />
                    </Grid>

                    <ItemsControl x:Name="UsageList" Grid.Row="2" Template="{StaticResource ScrollingItems}" Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="42" Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="22" Height="22" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding DownText}" Foreground="{DynamicResource DownBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding UpText}" Foreground="{DynamicResource UpBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{Binding TotalText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <!-- Anteil am größten Verbraucher: Download und Upload hintereinander -->
                                    <Grid Grid.Column="5" Height="8" VerticalAlignment="Center">
                                        <Border CornerRadius="4" Background="{DynamicResource Hover}" />
                                        <Border CornerRadius="4" Background="{DynamicResource UpBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding TotalShare}" />
                                            </Border.RenderTransform>
                                        </Border>
                                        <Border CornerRadius="4" Background="{DynamicResource DownBrush}" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding DownShare}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="UsageEmpty" Grid.Row="2" Text="Für diesen Zeitraum gibt es noch keine Daten." Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===== Einstellungen (Overlay) ===== -->
        <Grid x:Name="SettingsOverlay" Background="{DynamicResource Scrim}" Visibility="Collapsed" MouseDown="SettingsOverlay_MouseDown">
            <Border Width="560" MaxHeight="760" VerticalAlignment="Center" CornerRadius="14" Background="{DynamicResource Dialog}" BorderBrush="{DynamicResource DialogBorder}" BorderThickness="1"
                    MouseDown="SettingsCard_MouseDown">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Click="CloseSettings_Click" Width="34" Height="34" Padding="0"
                                    ToolTip="Schließen (Esc)" AutomationProperties.Name="Einstellungen schließen">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE711;" FontSize="12" />
                            </Button>
                            <TextBlock Text="Einstellungen" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="DESIGN" Style="{StaticResource Section}" />
                        <ListBox x:Name="ThemeList" SelectionChanged="Theme_Changed" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Design auswählen">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bg" Margin="3" Padding="6" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Hover}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Ink}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- Mini-Vorschau: Hintergrund, Karte, Akzent-Punkt, Download-/Upload-Balken -->
                                        <Border Height="58" CornerRadius="6" Background="{Binding PreviewBg}">
                                            <Border Margin="8" CornerRadius="4" Background="{Binding PreviewPanel}">
                                                <Grid Margin="6">
                                                    <Rectangle Width="28" Height="4" RadiusX="2" RadiusY="2" Fill="{Binding PreviewInk}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                                    <Ellipse Width="9" Height="9" Fill="{Binding PreviewAccent}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <Rectangle Width="34" Height="5" RadiusX="2" RadiusY="2" Fill="{Binding PreviewDown}" Margin="0,0,4,0" />
                                                        <Rectangle Width="20" Height="5" RadiusX="2" RadiusY="2" Fill="{Binding PreviewUp}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Margin="2,6,0,0" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Inspiration}" Style="{StaticResource Caption}" FontSize="11" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="ANZEIGE" Style="{StaticResource Section}" />
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <RadioButton x:Name="UnitBytes" Content="KB/s · MB/s" GroupName="Unit" Style="{StaticResource Pill}" Checked="Unit_Changed" MinWidth="96" />
                                <RadioButton x:Name="UnitBits" Content="Mbit/s" GroupName="Unit" Style="{StaticResource Pill}" Checked="Unit_Changed" />
                            </StackPanel>
                            <TextBlock Text="Einheit" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <RadioButton x:Name="Range60" Content="1 Min" Tag="60" GroupName="Range" Style="{StaticResource Pill}" Checked="Range_Changed" />
                                <RadioButton x:Name="Range300" Content="5 Min" Tag="300" GroupName="Range" Style="{StaticResource Pill}" Checked="Range_Changed" />
                                <RadioButton x:Name="Range900" Content="15 Min" Tag="900" GroupName="Range" Style="{StaticResource Pill}" Checked="Range_Changed" />
                            </StackPanel>
                            <TextBlock Text="Zeitraum des Graphen" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="START" Style="{StaticResource Section}" />
                        <CheckBox x:Name="AutostartBox" Content="Mit Windows starten" Click="Autostart_Click" Foreground="{DynamicResource Ink}" />
                        <CheckBox x:Name="StartInTrayBox" Content="Beim Start nur im Infobereich (Tray) anzeigen" Click="StartInTray_Click" Foreground="{DynamicResource Ink}" Margin="0,6,0,0" />

                        <TextBlock Text="BENACHRICHTIGUNGEN" Style="{StaticResource Section}" />
                        <CheckBox x:Name="NotifyNewAppsBox" Content="Melden, wenn ein Programm zum ersten Mal ins Internet geht" Click="NotifyNewApps_Click" Foreground="{DynamicResource Ink}" />

                        <TextBlock Text="SPIELMODUS" Style="{StaticResource Section}" />
                        <CheckBox x:Name="GameModeBox" Content="Spielmodus automatisch einschalten" Click="GameMode_Click" Foreground="{DynamicResource Ink}" />
                        <TextBlock Text="Sobald ein Programm mit Vorrang läuft, teilen sich alle anderen Programme dieses Limit. So bleibt der Ping niedrig, auch wenn im Hintergrund Downloads laufen."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,4" />
                        <TextBlock x:Name="PriorityText" Style="{StaticResource Caption}" TextWrapping="Wrap" Foreground="{DynamicResource UpBrush}" Margin="0,0,0,10" />
                        <ContentControl x:Name="GameEditor" ContentTemplate="{StaticResource LimitEditor}" Focusable="False" />

                        <TextBlock Text="PROFILE" Style="{StaticResource Section}" />
                        <TextBlock Text="Ein Profil speichert alle Limits und Sperren sowie das Gesamtlimit. Änderungen landen immer im gerade aktiven Profil (oben in der Kopfzeile)."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,-4,0,10" />
                        <ItemsControl x:Name="ProfileList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,6" Margin="0,0,0,4" CornerRadius="8" Background="{DynamicResource PanelInner}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Click="DeleteProfile_Click" Width="30" Height="30" Padding="0"
                                                    ToolTip="Profil löschen" AutomationProperties.Name="Profil löschen">
                                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74D;" FontSize="12" />
                                            </Button>
                                            <TextBlock Text="{Binding}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Als neues Profil speichern" Click="NewProfile_Click" Height="34" Margin="8,0,0,0" />
                            <TextBox x:Name="NewProfileName" Height="34" VerticalContentAlignment="Center" AutomationProperties.Name="Name des neuen Profils"
                                     ToolTip="Name, z. B. Arbeit oder Gaming" />
                        </DockPanel>
                        <TextBlock x:Name="NewProfileHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="ZEITPLÄNE" Style="{StaticResource Section}" />
                        <TextBlock Text="Zur angegebenen Zeit wird das Profil automatisch aktiviert, danach gilt wieder dein gewähltes Profil. Die oberste passende Regel gewinnt. Bis-Zeit vor Von-Zeit = über Mitternacht."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,-4,0,10" />
                        <ItemsControl x:Name="ScheduleList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" Margin="0,0,0,6" CornerRadius="8" Background="{DynamicResource PanelInner}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Click="DeleteSchedule_Click" Width="30" Height="30" Padding="0"
                                                        ToolTip="Zeitplan löschen" AutomationProperties.Name="Zeitplan löschen">
                                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74D;" FontSize="12" />
                                                </Button>
                                                <CheckBox IsChecked="{Binding Enabled}" MinWidth="0" VerticalAlignment="Center" Margin="0,0,6,0"
                                                          AutomationProperties.Name="Zeitplan aktiv" />
                                                <TextBlock Text="Profil" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox ItemsSource="{Binding ProfileNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Profile}" MinWidth="140" HorizontalAlignment="Left" AutomationProperties.Name="Profil des Zeitplans" />
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <StackPanel.Resources>
                                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                        <Setter Property="Width" Value="38" />
                                                        <Setter Property="Height" Value="30" />
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0,0,3,0" />
                                                        <Setter Property="FontSize" Value="12" />
                                                    </Style>
                                                </StackPanel.Resources>
                                                <ToggleButton Content="Mo" IsChecked="{Binding Mo}" />
                                                <ToggleButton Content="Di" IsChecked="{Binding Di}" />
                                                <ToggleButton Content="Mi" IsChecked="{Binding Mi}" />
                                                <ToggleButton Content="Do" IsChecked="{Binding Do}" />
                                                <ToggleButton Content="Fr" IsChecked="{Binding Fr}" />
                                                <ToggleButton Content="Sa" IsChecked="{Binding Sa}" />
                                                <ToggleButton Content="So" IsChecked="{Binding So}" />
                                                <TextBox Text="{Binding From}" Width="64" Height="30" Margin="10,0,4,0" VerticalContentAlignment="Center"
                                                         AutomationProperties.Name="Von (Uhrzeit)" ToolTip="Von, z. B. 09:00" />
                                                <TextBlock Text="–" VerticalAlignment="Center" />
                                                <TextBox Text="{Binding To}" Width="64" Height="30" Margin="4,0,0,0" VerticalContentAlignment="Center"
                                                         AutomationProperties.Name="Bis (Uhrzeit)" ToolTip="Bis, z. B. 17:00" />
                                            </StackPanel>
                                            <TextBlock Text="Uhrzeit im Format 09:00 eingeben und mindestens einen Tag wählen." Foreground="{DynamicResource Danger}"
                                                       FontSize="12" Margin="0,6,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Zeitplan hinzufügen" Click="AddSchedule_Click" HorizontalAlignment="Left" Height="34" Margin="0,2,0,0" />

                        <TextBlock Text="VPN (WIREGUARD)" Style="{StaticResource Section}" />
                        <TextBlock Text="WireGuard-Configs (.conf) laden – z. B. von Proton VPN, Mullvad oder deinem eigenen Server – und dann einzelnen Programmen im Detailbereich zuweisen. Nur deren Verkehr (TCP und UDP) läuft durch den Tunnel. Configs werden verschlüsselt gespeichert."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,-4,0,10" />
                        <TextBlock x:Name="VpnEmpty" Text="Noch keine Config geladen." Style="{StaticResource Caption}" Margin="0,0,0,6" />
                        <ItemsControl x:Name="VpnList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8" Margin="0,0,0,4" CornerRadius="8" Background="{DynamicResource PanelInner}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Click="DeleteVpn_Click" Width="30" Height="30" Padding="0" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="VPN entfernen" AutomationProperties.Name="VPN entfernen">
                                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74D;" FontSize="12" />
                                            </Button>
                                            <CheckBox DockPanel.Dock="Right" Content="Kill-Switch" IsChecked="{Binding KillSwitch}" Foreground="{DynamicResource Ink}" MinWidth="0"
                                                      VerticalAlignment="Center" ToolTip="Verliert der Tunnel die Verbindung oder wird FlowCap beendet, werden die zugewiesenen Programme beendet" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="WireGuard-Config laden …" Click="ImportVpn_Click" HorizontalAlignment="Left" Height="34" Padding="14,0" Margin="0,4,0,0" />
                        <TextBlock x:Name="VpnHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Text="PROXYS" Style="{StaticResource Section}" />
                        <TextBlock Text="SOCKS5- oder HTTP-Proxys einrichten und dann einzelnen Programmen im Detailbereich zuweisen. Passwörter werden verschlüsselt gespeichert."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,-4,0,10" />
                        <ItemsControl x:Name="ProxyList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,6" Margin="0,0,0,4" CornerRadius="8" Background="{DynamicResource PanelInner}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Click="DeleteProxy_Click" Width="30" Height="30" Padding="0" Margin="6,0,0,0"
                                                    ToolTip="Proxy löschen" AutomationProperties.Name="Proxy löschen">
                                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE74D;" FontSize="12" />
                                            </Button>
                                            <Button DockPanel.Dock="Right" Content="Testen" Click="TestProxy_Click" Height="30" Padding="10,0" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="ProxyEmpty" Text="Noch kein Proxy eingerichtet." Style="{StaticResource Caption}" Margin="0,0,0,6" />

                        <!-- Neuer Proxy: jedes Feld mit eigener Beschriftung -->
                        <Border Padding="16,14" CornerRadius="10" Background="{DynamicResource PanelInner}" Margin="0,4,0,0">
                            <StackPanel>
                                <StackPanel.Resources>
                                    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                    </Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Height" Value="34" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                    </Style>
                                </StackPanel.Resources>

                                <TextBlock Text="Neuer Proxy" FontWeight="SemiBold" Margin="0,0,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ProxyNameBox" AutomationProperties.Name="Name des Proxys" ToolTip="Frei wählbar, z. B. Büro oder Test" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Typ" Style="{StaticResource FieldLabel}" />
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ProxyTypeSocks" Content="SOCKS5" IsChecked="True" GroupName="ProxyType" Style="{StaticResource Pill}" Height="34" />
                                            <RadioButton x:Name="ProxyTypeHttp" Content="HTTP" GroupName="ProxyType" Style="{StaticResource Pill}" Height="34" Margin="0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Server (Adresse oder IP)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ProxyHostBox" AutomationProperties.Name="Proxy-Server" ToolTip="z. B. proxy.example.com oder 127.0.0.1" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ProxyPortBox" AutomationProperties.Name="Proxy-Port" ToolTip="z. B. 1080 für SOCKS5, 8080 für HTTP" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Benutzername (optional)" Style="{StaticResource FieldLabel}" />
                                        <TextBox x:Name="ProxyUserBox" AutomationProperties.Name="Proxy-Benutzername" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Passwort (optional)" Style="{StaticResource FieldLabel}" />
                                        <PasswordBox x:Name="ProxyPasswordBox" Height="34" VerticalContentAlignment="Center" AutomationProperties.Name="Proxy-Passwort" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                    <Button Content="Verbindung testen" Click="TestProxy_Click" Height="34" Padding="14,0" Margin="0,0,8,0" />
                                    <Button Content="Proxy hinzufügen" Click="AddProxy_Click" Height="34" Padding="14,0" Style="{DynamicResource AccentButtonStyle}" />
                                </StackPanel>
                                <TextBlock x:Name="ProxyHint" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ProxyStatus" Foreground="{DynamicResource Danger}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />

                        <TextBlock Text="GESAMTLIMIT FÜR ALLE PROGRAMME" Style="{StaticResource Section}" />
                        <TextBlock Text="Gilt zusätzlich zu den Limits einzelner Programme. Die Programme teilen sich die Bandbreite reihum."
                                   Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,-4,0,10" />
                        <ContentControl x:Name="TotalEditor" ContentTemplate="{StaticResource LimitEditor}" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
